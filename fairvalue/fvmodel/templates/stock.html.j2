{% extends "base.html.j2" %}
{% macro row(key) %}{% set m = r.metrics[key] %}
<tr><td>{{ m.label }}</td><td class="num">{{ fmt(m, cur) }}{% if m.verdict_text %} <span class="verdict {{ m.verdict or '' }}">{{ m.verdict_text }}</span>{% endif %}</td></tr>
{%- endmacro %}
{% macro table(title, keys) %}
<div class="panel">
  <h3 class="panel-title">{{ title }}</h3>
  <div class="table-wrap"><table class="data metric-table"><tbody>
  {% for k in keys %}{{ row(k) }}{% endfor %}
  </tbody></table></div>
</div>
{% endmacro %}
{% block title %}{{ r.ticker }} {{ r.name }}{% endblock %}
{% block description %}Fair Value summary for {{ r.name }} ({{ r.ticker }}): Fair Value, Quality Score, financial strength, profitability, growth and valuation.{% endblock %}
{% block body %}
    <div class="eyebrow">Stock summary · fundamentals to {{ r.as_of.strftime('%d %b %Y') }}</div>
    <h1>{{ r.name }} <span class="gradient-text">{{ r.ticker }}</span></h1>
    {% set gv = r.metrics['fair_value'] %}{% set p2 = r.metrics['price_to_fair_value'] %}
    <p class="lead">Price <span class="hl-accent">{{ cur }}{{ "%.2f"|format(r.price) }}</span> on {{ r.price_date.strftime('%d %b %Y') }}.
      {% if gv.ok %}The Fair Value is <span class="hl-accent">{{ cur }}{{ "%.2f"|format(gv.value) }}</span>, so the stock looks <mark>{{ gv.verdict_text|lower }}</mark> at {{ "%.2f"|format(p2.value) }}× its fair value.{% else %}Not enough history to compute a Fair Value.{% endif %}</p>

    <div class="kpis">
      <div class="panel kpi"><div class="label">Price</div><div class="value">{{ cur }}{{ "%.2f"|format(r.price) }}</div>
        <div class="sub">{{ fmt(r.metrics['pct_below_high'], cur) }} below 52-week high</div></div>
      <div class="panel kpi"><div class="label">Fair Value</div><div class="value">{{ fmt(gv, cur) }}</div>
        <div class="sub">{% if gv.verdict_text %}<span class="verdict {{ gv.verdict or '' }}">{{ gv.verdict_text }}</span>{% else %}n/a{% endif %}</div></div>
      {% set gs = r.metrics['quality_score'] %}
      <div class="panel kpi"><div class="label">Fair Value Score</div><div class="value">{{ fmt(gs, cur) }}</div>
        <div class="sub">{% if gs.verdict_text %}<span class="verdict {{ gs.verdict or '' }}">{{ gs.verdict_text }}</span>{% endif %}</div></div>
      <div class="panel kpi"><div class="label">Market cap</div><div class="value">{{ money(r.market_cap, cur) }}</div>
        <div class="sub">EV {{ money(r.enterprise_value, cur) }} · yield {{ fmt(r.metrics['dividend_yield'], cur) }}</div></div>
      <div class="panel kpi"><div class="label">PE (TTM)</div><div class="value">{{ fmt(r.metrics['pe_ttm'], cur) }}</div>
        <div class="sub">Shiller PE {{ fmt(r.metrics['shiller_pe'], cur) }}</div></div>
    </div>

    {% if r.notes %}<div class="notice">{% for n in r.notes %}{{ n }}{% if not loop.last %}<br>{% endif %}{% endfor %}</div>{% endif %}

    <h2 class="section">Quality Score breakdown</h2>
    <div class="two-col">
      <div class="panel ranks">
        <h3 class="panel-title">Ranks (1–10)</h3>
        {% for k in ['rank_financial_strength','rank_profitability','rank_growth','rank_fair_value','rank_momentum'] %}{% set m = r.metrics[k] %}
        <div class="dist-row"><div class="dist-label">{{ m.label }}</div>
          <div class="dist-track"><div class="dist-bar" style="width:{{ (m.value or 0) * 10 }}%;background:var({{ '--under' if (m.value or 0) >= 7 else '--accent' if (m.value or 0) >= 4 else '--over' }})"></div></div>
          <div class="dist-count">{{ m.value if m.ok else '–' }}</div></div>
        {% endfor %}
        <p class="muted small">Predictability {{ fmt(r.metrics['predictability'], cur) }} stars. Ranks use Fair Value's published inputs with our own fixed breakpoints.</p>
      </div>
      {{ table("Valuation verdicts", ['price_to_fair_value','altman_z','beneish_m','roic','piotroski_f']) }}
    </div>

    <div class="panel chart-panel">
      <div class="chart-head"><h3>Price vs Fair Value, 10 years</h3>
        <div class="legend"><span><i style="background:var(--accent)"></i>Price</span><span><i style="background:var(--under)"></i>Fair Value</span></div></div>
      <div id="chart-gfv" class="chart short"></div>
    </div>

    <h2 class="section">Fundamentals</h2>
    <div class="two-col">
      {{ table("Financial strength", ['cash_to_debt','equity_to_asset','debt_to_equity','debt_to_ebitda','interest_coverage','piotroski_f','altman_z','beneish_m','wacc','roic']) }}
      {{ table("Profitability", ['gross_margin','operating_margin','net_margin','fcf_margin','roe','roa','roic','roc_greenblatt','roce','years_profitable']) }}
      {{ table("Growth (per share, fiscal years)", ['revenue_growth_3y','revenue_growth_5y','revenue_growth_10y','ebitda_growth_3y','ebitda_growth_5y','eps_growth_3y','eps_growth_5y','fcf_growth_3y','fcf_growth_5y','book_growth_3y']) }}
      {{ table("Liquidity", ['current_ratio','quick_ratio','cash_ratio','days_sales_outstanding','days_inventory','days_payable','cash_conversion_cycle']) }}
      {{ table("Dividends & buybacks", ['dividend_yield','dividend_per_share','payout_ratio','dividend_growth_3y','yield_on_cost_5y','buyback_yield','buyback_ratio_3y','shareholder_yield']) }}
      {{ table("Momentum", ['rsi_5','rsi_9','rsi_14','momentum_6_1','momentum_12_1','high_52w','low_52w','beta']) }}
    </div>

    <h2 class="section">Valuation</h2>
    <div class="panel">
      <h3 class="panel-title">Ratios against their own 10-year range</h3>
      <div class="table-wrap"><table class="data metric-table" data-list>
        <thead><tr><th data-list="title">Ratio</th><th class="num" data-list="value">Current</th><th class="num">10y min</th><th class="num">Median</th><th class="num">10y max</th><th data-list="note">Position in 10-year range</th></tr></thead>
        <tbody>
        {% for k in ['pe_ttm','ps','pb','price_to_fcf','price_to_tangible_book','price_to_ocf','ev_to_ebit','ev_to_ebitda','ev_to_revenue','ev_to_fcf','peg','shiller_pe','earnings_yield','fcf_yield','forward_rate_of_return'] %}{% set m = r.metrics[k] %}
        <tr><td>{{ m.label }}</td><td class="num">{{ fmt(m, cur) }}</td>
          {% if m.hist %}<td class="num">{{ "%.2f"|format(m.hist.min) }}</td><td class="num">{{ "%.2f"|format(m.hist.median) }}</td><td class="num">{{ "%.2f"|format(m.hist.max) }}</td>
          <td><div class="range"><div class="dist-track"><div class="tick" style="left:calc({{ m.hist.pct_rank|round(0) }}% - 1px)"></div></div>
            <span class="verdict {{ 'under' if m.hist.pct_rank < 40 else 'over' if m.hist.pct_rank > 60 else '' }}">{{ 'Cheaper' if m.hist.pct_rank < 50 else 'Pricier' }} than {{ (m.hist.pct_rank if m.hist.pct_rank >= 50 else 100 - m.hist.pct_rank)|round(0)|int }}%</span></div></td>
          {% else %}<td class="num muted">–</td><td class="num muted">–</td><td class="num muted">–</td><td class="muted small">{{ m.note }}</td>{% endif %}</tr>
        {% endfor %}
        </tbody></table></div>
    </div>

    <div class="two-col" style="margin-top:14px">
      <div class="panel">
        <h3 class="panel-title">Intrinsic value estimates</h3>
        <div class="table-wrap"><table class="data metric-table" data-list>
          <thead><tr><th data-list="title">Model</th><th class="num" data-list="value">Value</th><th class="num" data-list="note">Price / value</th></tr></thead><tbody>
          {% for v, p in [('fair_value','price_to_fair_value'),('iv15','price_to_iv15'),('dcf_earnings','price_to_dcf'),('projected_fcf_value','price_to_projected_fcf'),('median_ps_value','price_to_median_ps'),('peter_lynch_value','price_to_lynch'),('graham_number','price_to_graham'),('epv','price_to_epv'),('ncav','price_to_ncav')] %}
          {% set mv = r.metrics[v] %}{% set mp = r.metrics[p] %}
          <tr><td>{{ mv.label }}</td><td class="num">{{ fmt(mv, cur) }}</td>
            <td class="num">{% if mp.ok %}<span class="verdict {{ 'under' if mp.value < 0.9 else 'over' if mp.value > 1.1 else '' }}">{{ "%.2f"|format(mp.value) }}× {{ 'under' if mp.value < 0.9 else 'over' if mp.value > 1.1 else 'fair' }}</span>{% else %}–{% endif %}</td></tr>
          {% endfor %}
          <tr><td>Net-Net Working Capital</td><td class="num">{{ fmt(r.metrics['nnwc'], cur) }}</td><td class="num">–</td></tr>
          </tbody></table></div>
        <p class="muted small">{{ r.metrics['dcf_earnings'].note }}.</p>
      </div>
      <div class="panel chart-panel" style="margin-top:0">
        <div class="chart-head"><h3>PE ratio, 10 years</h3>
          <div class="legend"><span><i style="background:var(--accent)"></i>PE (TTM)</span><span><i style="background:var(--faint)"></i>10y median</span></div></div>
        <div id="chart-pe" class="chart short"></div>
      </div>
    </div>

    {% set rd = r.metrics['reverse_dcf_growth'] %}{% set ig = r.metrics['iv15_implied_growth'] %}
    <h2 class="section">Reverse DCF and IV15</h2>
    <p class="muted">What growth does the price already assume? Both models start from owner free cash flow: FCF minus
      stock-based compensation, per diluted share.
      {% if rd.ok %}At {{ cur }}{{ "%.2f"|format(r.price) }} the market is pricing in <mark>{{ "%.1f"|format(rd.value) }}% a year</mark> for
      {{ rd.extra.years }} years{% if rd.extra.reference is not none %}, against {{ "%.1f"|format(rd.extra.reference) }}% {{ rd.extra.reference_label }}{% endif %}.{% endif %}
      {% if ig.ok %}To earn 15% a year from here, owner FCF would have to grow <span class="hl-accent">{{ "%.1f"|format(ig.value) }}%</span> a year for 15 years.{% endif %}</p>
    <div class="two-col">
      <div class="panel">
        <h3 class="panel-title">What the price implies</h3>
        <div class="table-wrap"><table class="data metric-table"><tbody>
          {{ row('owner_fcf_ps') }}{{ row('reverse_dcf_growth') }}{{ row('reverse_dcf_discount') }}{{ row('iv15_implied_growth') }}{{ row('iv15') }}
          {% set p15 = r.metrics['price_to_iv15'] %}
          <tr><td>{{ p15.label }}</td><td class="num">{% if p15.ok %}<span class="verdict {{ 'under' if p15.value < 0.9 else 'over' if p15.value > 1.1 else '' }}">{{ "%.2f"|format(p15.value) }}× {{ 'under' if p15.value < 0.9 else 'over' if p15.value > 1.1 else 'fair' }}</span>{% else %}{{ fmt(p15, cur) }}{% endif %}</td></tr>
        </tbody></table></div>
        <h3 class="panel-title" style="margin-top:14px">Its record (per share, fiscal years)</h3>
        <div class="table-wrap"><table class="data metric-table"><tbody>
          {% for k in ['fcf_growth_5y','fcf_growth_10y','revenue_growth_5y','revenue_growth_10y','eps_growth_10y'] %}{{ row(k) }}{% endfor %}
        </tbody></table></div>
        <p class="muted small">Reverse DCF: owner FCF grows at the implied rate for {{ rd.extra.years }} years, then {{ "%.0f"|format(rd.extra.terminal * 100) }}% forever,
          discounted at the cost of equity (10-year Treasury + beta × 6%, at least {{ "%.0f"|format(rd.extra.floor * 100) }}%).
          IV15, as in the <a href="{{ root }}../iv15_calculator.html">IV15 calculator</a>: {{ r.metrics['iv15'].note }}.</p>
      </div>
      <div class="panel chart-panel" style="margin-top:0">
        <div class="chart-head"><h3>Value per share at each growth rate</h3>
          <div class="legend"><span><i class="sw-accent ln"></i>Reverse DCF model</span><span><i class="sw-series-2 ln"></i>IV15 model</span><span><i class="sw-neutral ln"></i>Price</span></div></div>
        {% if r.charts.growth_curve %}<div id="chart-growth" class="chart short"></div>
        <p class="muted small">Where a curve crosses the price is the growth the price implies under that model. Annual owner-FCF growth on the horizontal axis.</p>
        {% else %}<p class="muted">Not available: {{ fmt(r.metrics['owner_fcf_ps'], cur)|lower if r.metrics['owner_fcf_ps'].note else 'no free cash flow data' }}.</p>{% endif %}
      </div>
    </div>

    <h2 class="section">Financials by fiscal year</h2>
    <div class="panel chart-panel">
      <div class="chart-head"><h3>Revenue, net income and free cash flow</h3>
        <div class="legend"><span><i style="background:var(--accent)"></i>Revenue</span><span><i style="background:var(--under)"></i>Net income</span><span><i style="background:var(--hl-text)"></i>Free cash flow</span></div></div>
      <div id="chart-fin" class="chart short"></div>
    </div>
    <div class="table-wrap" style="margin-top:14px"><table class="data" data-list>
      <thead><tr><th data-list="title">Fiscal year</th><th class="num" data-list="value">Revenue</th><th class="num">Gross margin</th><th class="num">Op. margin</th><th class="num" data-list="note" data-list-prefix="Net income">Net income</th><th class="num">EPS</th><th class="num">FCF</th><th class="num">DPS</th><th class="num">Shares</th><th class="num">Debt</th><th class="num">Equity</th><th class="num">ROE</th></tr></thead>
      <tbody>{% for a in r.annual|reverse %}
        <tr><td class="sym">{{ a.fy.strftime('%Y-%m') }}</td><td class="num">{{ money(a.revenue, cur) }}</td><td class="num">{{ pctf(a.gross_margin) }}</td><td class="num">{{ pctf(a.operating_margin) }}</td>
          <td class="num">{{ money(a.net_income, cur) }}</td><td class="num">{{ num(a.eps) }}</td><td class="num">{{ money(a.fcf, cur) }}</td><td class="num">{{ num(a.dps) }}</td>
          <td class="num">{{ count(a.shares) }}</td><td class="num">{{ money(a.debt, cur) }}</td><td class="num">{{ money(a.equity, cur) }}</td><td class="num">{{ pctf(a.roe) }}</td></tr>
      {% endfor %}</tbody></table></div>
{% endblock %}
{% block scripts %}
<script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
<script>
  const CUR = {{ cur|tojson }};   // currency label for chart axes and tooltips
  const D = {{ charts_json }};
  const C = Nexus.colors;
  const GOLD = C.series2;
  const line = (x, y, name, color, extra) => Object.assign({ type: "scatter", mode: "lines", x, y, name, line: { color, width: 2 },
    hovertemplate: "%{x|%b %Y}<br>" + name + ": %{y:.2f}<extra></extra>" }, extra || {});
  const traces = [line(D.dates, D.price, "Price", C.accent)];
  if (D.fair_value) traces.push(line(D.dates, D.fair_value, "Fair Value", C.positive, { line: { color: C.positive, width: 2, dash: "dot" } }));
  Plotly.newPlot("chart-gfv", traces, Nexus.plotlyLayout({ showlegend: false, yaxis: { tickprefix: CUR }, hovermode: "x unified" }), Nexus.plotlyConfig);

  const pe = D.pe.filter(v => v !== null).sort((a, b) => a - b);
  const med = pe.length ? pe[Math.floor(pe.length / 2)] : null;
  const peTraces = [line(D.pe_dates, D.pe, "PE", C.accent)];
  if (med !== null) peTraces.push(line([D.pe_dates[0], D.pe_dates[D.pe_dates.length - 1]], [med, med], "10y median", C.faint, { line: { color: C.faint, width: 1.5, dash: "dash" } }));
  Plotly.newPlot("chart-pe", peTraces, Nexus.plotlyLayout({ showlegend: false, hovermode: "x unified" }), Nexus.plotlyConfig);

  const bar = (y, name, color) => ({ type: "bar", x: D.fy, y: y.map(v => v === null ? null : v / 1e9), name,
    marker: { color, cornerradius: 3 }, hovertemplate: "FY%{x}<br>" + name + ": " + CUR + "%{y:.1f}B<extra></extra>" });
  Plotly.newPlot("chart-fin", [bar(D.revenue, "Revenue", C.accent), bar(D.net_income, "Net income", C.positive), bar(D.fcf, "Free cash flow", GOLD)],
    Nexus.plotlyLayout({ barmode: "group", showlegend: false, yaxis: { tickprefix: CUR, ticksuffix: "B" } }), Nexus.plotlyConfig);
  // Charts are drawn before the remote stylesheet settles the layout; fit them once it has.
  if (D.growth_curve) {
    const G = D.growth_curve, price = {{ "%.2f"|format(r.price) }};
    const curve = (y, name, color) => line(G.growth, y, name, color, {
      hovertemplate: "%{x:.0f}% a year<br>" + name + ": " + CUR + "%{y:.2f}<extra></extra>" });
    const top = Math.max(price * 2.5, ...G.reverse_dcf.slice(0, 11), ...G.iv15.slice(0, 11));
    Plotly.newPlot("chart-growth", [
      curve(G.reverse_dcf, "Reverse DCF model", C.accent), curve(G.iv15, "IV15 model", GOLD),
      line([G.growth[0], G.growth[G.growth.length - 1]], [price, price], "Price", C.neutral,
        { line: { color: C.neutral, width: 1.5, dash: "dash" }, hovertemplate: "Price: " + CUR + "%{y:.2f}<extra></extra>" }),
      {% for key, name, color in [('reverse_dcf_growth', 'Implied by the price', 'C.accent'), ('iv15_implied_growth', 'Needed for 15% a year', 'GOLD')] %}{% if r.metrics[key].ok %}
      { type: "scatter", mode: "markers", x: [{{ "%.2f"|format(r.metrics[key].value) }}], y: [price], name: "{{ name }}",
        marker: { color: {{ color }}, size: 10, line: { color: C.surface, width: 2 } },
        hovertemplate: "{{ name }}: %{x:.1f}% a year<extra></extra>" },{% endif %}{% endfor %}
    ], Nexus.plotlyLayout({ showlegend: false, hovermode: "closest", xaxis: { ticksuffix: "%" },
      yaxis: { tickprefix: CUR, range: [0, top] } }), Nexus.plotlyConfig);
  }
  window.addEventListener("load", () => document.querySelectorAll(".js-plotly-plot").forEach(el => Plotly.Plots.resize(el)));
</script>
{% endblock %}
